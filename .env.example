# Backblaze B2 (secure.backblaze.com/app_keys.htm)
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=character-vault
B2_REGION=

# OpenAI (platform.openai.com/api-keys) - character portrait generation, fallback voice lines
OPENAI_API_KEY=

# GMI Cloud (console.gmicloud.ai) - identity images, video, and voice lines (Inworld TTS)
GMI_API_KEY=

CORS_ORIGINS=http://localhost:3000

# Owner key. Sent as the X-API-Key header it lifts every limit below.
# Keep it out of anything you share — it spends real provider credit.
GENERATE_API_KEY=

# Where the SQLite metadata lives. Under docker compose this points at the
# named volume; leaving it unset writes inside the container, so every
# redeploy would wipe the characters *and* the workspace tokens.
DB_PATH=/data/character_vault.db

# ── Public portfolio link ────────────────────────────────────────────────
# Lifetime generation budget per workspace, in units (image = 1, video = 20).
# 40 covers one full pass: a character, a few images, a voice line, a video.
WORKSPACE_UNIT_QUOTA=40

# Workspaces one IP may create. Not 1 on purpose: colleagues behind a shared
# company NAT all arrive from the same public IP, and a hard 1 would lock out
# everyone after the first visitor.
MAX_WORKSPACES_PER_IP=3

# Backstops shared across all visitors, per day.
RATE_GLOBAL_PER_DAY=400
RATE_VIDEO_PER_DAY=12
